# Magnate environment configuration

# --- AI CEO (required for live mode) --------------------------------------
# Anthropic API key — powers Vera (the AI CEO) and the AI employees.
# Get one at https://console.anthropic.com/
# If unset, Magnate runs in "demo mode" with simulated agent responses.
ANTHROPIC_API_KEY=

# Optional: override the model used by the agents (defaults to claude-opus-4-7)
# MAGNATE_MODEL=claude-opus-4-7

# --- Webflow blog (required for publishing to the blog) -------------------
# Webflow v2 Data API token with CMS read/write scope.
# Webflow → Site settings → Apps & integrations → API access → Generate token.
# When set, Vera and the Head of Content (Casey) can publish posts to the blog.
WEBFLOW_API_TOKEN=

# Optional: pin the exact CMS collection / site. If omitted, Magnate
# auto-discovers a collection named like "Blog"/"Posts" on your first site.
# WEBFLOW_BLOG_COLLECTION_ID=
# WEBFLOW_SITE_ID=
