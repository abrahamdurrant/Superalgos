# Magnate environment configuration

# Anthropic API key — powers Vera (the AI CEO) and the AI employees.
# Get one at https://console.anthropic.com/
# If unset, Magnate runs in "demo mode" with simulated agent responses,
# so the full product is still explorable without a key.
ANTHROPIC_API_KEY=

# Optional: override the model used by the agents (defaults to claude-opus-4-7)
# MAGNATE_MODEL=claude-opus-4-7
