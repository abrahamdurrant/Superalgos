# ---------------------------------------------------------------------------
# SECRETS DO NOT BELONG IN THIS FILE.
#
# Store them in your OS keychain instead - they are then encrypted at rest and
# unlocked by your login, and nothing sensitive is ever written into the repo:
#
#     node bin/cli.js secrets set QUIVER_API_KEY
#     node bin/cli.js secrets set PUBLIC_SECRET_KEY
#
# Or pull them from a password manager at run time, so they are never at rest
# on this machine at all:
#
#     QUIVER_API_KEY_CMD='op read op://Private/Quiver/credential'
#     PUBLIC_SECRET_KEY_CMD='pass show trading/public-secret'
#
# Check your setup any time with:  node bin/cli.js secrets doctor
# ---------------------------------------------------------------------------

# Optional. Leave blank to auto-discover. Set this to pin a specific account
# (e.g. your IRA). This is an identifier, not a credential.
PUBLIC_ACCOUNT_ID=

# ---- Safety ----
# DRY_RUN=true  -> everything runs, orders are logged but NEVER sent to Public.
# DRY_RUN=false -> approved orders are really submitted with real money.
DRY_RUN=true

# Minutes an access token stays valid. Shorter limits the blast radius of a leak.
PUBLIC_TOKEN_MINUTES=60

# How often `watch` polls Quiver. Disclosures lag by up to 45 days; hourly is plenty.
POLL_MINUTES=60
