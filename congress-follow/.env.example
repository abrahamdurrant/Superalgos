# ---- Quiver Quantitative ----
# API key from https://www.quiverquant.com/api/  (sent as: Authorization: Bearer <key>)
QUIVER_API_KEY=

# ---- Public.com ----
# Secret key from Public: Settings -> Security -> API
PUBLIC_SECRET_KEY=
# Optional. Leave blank to auto-discover. Set this to pin a specific account (e.g. your IRA).
PUBLIC_ACCOUNT_ID=

# ---- Safety ----
# DRY_RUN=true  -> everything runs, orders are logged but NEVER sent to Public.
# DRY_RUN=false -> approved orders are really submitted with real money.
DRY_RUN=true
